{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git ls-files *)",
      "Bash(git push *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma validate *)",
      "Bash(vercel ls *)",
      "Bash(vercel whoami *)"
    ],
    "ask": [
      "Bash(pnpm db:push *)",
      "Bash(npx prisma db *)",
      "Bash(npx prisma migrate *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(vercel * --prod*)",
      "Bash(vercel promote*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/bash-guard.py; [ ! -f \"$f\" ] || exec python3 -I \"$f\""
          }
        ]
      }
    ]
  }
}
